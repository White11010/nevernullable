{
  "name": "nevernullable",
  "version": "1.0.7",
  "description": "Option<T>, Some<T>, None types and runtime functions to safely write JS/TS code without using null and undefined",
  "main": "dist",
  "types": "dist",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "test": "jest",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^29.5.12",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "jest": "^29.7.0",
    "prettier": "3.8.3",
    "ts-jest": "^29.1.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.2",
    "typescript-eslint": "^8.59.3"
  },
  "keywords": [
    "option",
    "functional",
    "fp",
    "null",
    "nullable",
    "safe"
  ],
  "author": "Vladislav 'White11010' Beliavski",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/White11010/nevernullable.git"
  },
  "homepage": "https://github.com/White11010/nevernullable"
}
