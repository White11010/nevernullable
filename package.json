{
  "name": "nevernullable",
  "version": "2.1.0",
  "description": "Type-safe Option<T>, Some<T>, None for TypeScript and JavaScript. Replace null and undefined with a Rust-inspired Option type with map, andThen, filter, match, unwrap and Promise interop. Zero dependencies, dual ESM + CJS, ~2 KB.",
  "keywords": [
    "option",
    "option-type",
    "optional",
    "maybe",
    "maybe-monad",
    "monad",
    "some",
    "none",
    "nullable",
    "null",
    "null-safe",
    "nullsafe",
    "non-null",
    "non-nullable",
    "never-null",
    "type-safe",
    "typesafe",
    "typescript",
    "typescript-library",
    "ts",
    "functional",
    "functional-programming",
    "fp",
    "rust",
    "rust-option",
    "oxide",
    "neverthrow",
    "fp-ts",
    "match",
    "pattern-matching",
    "discriminated-union",
    "result",
    "esm"
  ],
  "homepage": "https://github.com/White11010/nevernullable#readme",
  "bugs": {
    "url": "https://github.com/White11010/nevernullable/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/White11010/nevernullable.git"
  },
  "license": "MIT",
  "author": {
    "name": "Vladislav 'White11010' Beliavski",
    "url": "https://github.com/White11010"
  },
  "type": "commonjs",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsup",
    "build:watch": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "bench": "ts-node --transpile-only bench/index.ts",
    "bench:save": "ts-node --transpile-only bench/index.ts > bench/RESULTS.md",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "npm run lint && npm run typecheck && npm run typecheck:tests && npm run test:coverage && npm run format:check && npm run build && npm run validate:package",
    "validate:package": "publint && attw --pack .",
    "prepack": "npm run clean && npm run build",
    "prepublishOnly": "npm run validate"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@eslint/js": "^10.0.1",
    "@types/jest": "^29.5.12",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "expect-type": "^1.3.0",
    "fp-ts": "^2.16.11",
    "globals": "^17.6.0",
    "jest": "^29.7.0",
    "oxide.ts": "^1.1.0",
    "prettier": "3.8.3",
    "publint": "^0.3.20",
    "tinybench": "^6.0.1",
    "ts-jest": "^29.1.5",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "typescript": "^5.5.2",
    "typescript-eslint": "^8.59.3"
  }
}
